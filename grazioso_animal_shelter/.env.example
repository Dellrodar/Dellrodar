# Copy to backend/.env and fill in real values. This file is read by both
# docker-compose (via env_file) and the backend app directly (pydantic-settings).

POSTGRES_USER=grazioso
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grazioso

# Host is "postgres" (the docker-compose service name) when the backend runs
# in docker-compose. Use "localhost" instead if running the backend directly
# on the host against the docker-compose'd Postgres (port 5432 is published).
DATABASE_URL=postgresql+asyncpg://grazioso:change-me@postgres:5432/grazioso

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

ADMIN_EMAIL=admin@grazioso-shelter.dev
ADMIN_PASSWORD=change-me

CORS_ORIGINS=http://localhost:5173
